{
  "mcpServers": {
    "node-code-sandbox": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "-v",
        "/Users/ajeetsraina/Desktop/sandbox-output:/root",
        "mcp/node-code-sandbox"
      ],
      "env": {
        "FILES_DIR": "/root",
        "SANDBOX_MEMORY_LIMIT": "512m",
        "SANDBOX_CPU_LIMIT": "0.75"
      }
    },
    "MCP_DOCKER": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ]
    },
    "penpot": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "PENPOT_URL=https://design.penpot.app",
        "-e",
        "PENPOT_TOKEN=eyJhbGciOiXXXV.EK_Tzo6M7sI7PXevibIXXXZe7Jx8QL4byQa5IJubP0-hJwkFgLSq_-Ha6LWU1aiU.-1pyoJ3wFLZhGw-spmD9ug",
        "ajeetraina777/penpot-mcp:latest"
      ]
    }
  }
}
