{
  "mcpServers": {
    "node-code-sandbox": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "-v",
        "/Users/ajeetsraina/Desktop/sandbox-output:/root",
        "mcp/node-code-sandbox"
      ],
      "env": {
        "FILES_DIR": "/root",
        "SANDBOX_MEMORY_LIMIT": "512m",
        "SANDBOX_CPU_LIMIT": "0.75"
      }
    },
    "MCP_DOCKER": {
      "command": "docker",
      "args": [
        "mcp",
        "gateway",
        "run"
      ]
    },
    "penpot": {
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e", "PENPOT_USERNAME=addmyname@email.com",
        "-e", "PENPOT_PASSWORD=change_me",
        "-e", "PENPOT_API_URL=https://design.penpot.app/api",
        "ajeetraina777/penpot-mcp:latest",
        "2>/dev/null"
      ]
    }
  }
}
